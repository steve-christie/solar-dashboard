{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": [
		"main"
	],
	"permissions": [
		"core:default",
		"shell:allow-open",
		"dialog:allow-open",
		{
			"identifier": "http:default",
			"allow": [
				{
					"name": "http:request",
					"scope": {
						"url": "https://**"
					}
				}
			]
		}
	]
}